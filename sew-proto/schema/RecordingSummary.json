{
  "$defs": {
    "AudioState": {
      "description": "The recording's audio. Stored in `recordings.audio_state`.",
      "oneOf": [
        {
          "const": "available",
          "description": "Kept.",
          "type": "string"
        },
        {
          "const": "expired",
          "description": "Hidden; links may still exist (held or not yet purged).",
          "type": "string"
        },
        {
          "const": "purged",
          "description": "Every link deleted; the content key is gone.",
          "type": "string"
        }
      ]
    },
    "StopReason": {
      "description": "Why a recording stopped. Stored in `recordings.stop_reason`.",
      "oneOf": [
        {
          "const": "stopped",
          "description": "The stop route.",
          "type": "string"
        },
        {
          "const": "room_empty",
          "description": "No standard voice entries left in the room.",
          "type": "string"
        },
        {
          "const": "call_ended",
          "description": "The DM call ended.",
          "type": "string"
        },
        {
          "const": "max_duration",
          "description": "`recording.max_duration_ms` reached.",
          "type": "string"
        },
        {
          "const": "recorder_failed",
          "description": "The recorder failed (join timeout, certificate, unreachable, too many rejoins).",
          "type": "string"
        },
        {
          "const": "media_restarted",
          "description": "The engine room was lost beyond the re-admit grace.",
          "type": "string"
        },
        {
          "const": "storage_full",
          "description": "Three consecutive `storage_full` segment writes.",
          "type": "string"
        },
        {
          "const": "disabled",
          "description": "Recording was disabled (policy, config, archive, `sew recording disable`).",
          "type": "string"
        },
        {
          "const": "max_bytes",
          "description": "`recording.max_bytes` reached.",
          "type": "string"
        },
        {
          "const": "mgmt_stopped",
          "description": "Stopped over the management API (the App or K2 governing the room).",
          "type": "string"
        }
      ]
    },
    "SummaryAudio": {
      "description": "The audio part of a [`RecordingSummary`].",
      "properties": {
        "expires_at": {
          "description": "When it expires (set at transcript final).",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "keep_days": {
          "description": "Keep days.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "mixed": {
          "description": "A mixed file is (or will be) made.",
          "type": "boolean"
        },
        "state": {
          "$ref": "#/$defs/AudioState",
          "description": "Its state."
        }
      },
      "required": [
        "state",
        "mixed",
        "keep_days"
      ],
      "type": "object"
    },
    "SummaryTranscript": {
      "description": "The transcript part of a [`RecordingSummary`].",
      "properties": {
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranscriptFailure"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why the transcript is `failed` or `partial`, as a stable code and plain words for the\nperson (`{\"code\": \"transcriber_error\", \"message\": \"...\"}`). Absent otherwise, when no\ncause is known, and from servers that predate it."
        },
        "gaps_ms": {
          "description": "Total gap time.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "lang": {
          "description": "The majority language of the turns.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/TranscriptState",
          "description": "Its state."
        },
        "turns": {
          "description": "Turns posted.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "state",
        "turns",
        "gaps_ms"
      ],
      "type": "object"
    },
    "TranscriptFailure": {
      "description": "Why a recording's transcript could not be made (`failed`) or is incomplete (`partial`):\n`{\"code\": \"transcriber_error\", \"message\": \"The transcription service could not process the\naudio.\"}`. `message` is plain words for the person, written by the server; `code` is stable\nfor a client that picks its own words.",
      "properties": {
        "code": {
          "$ref": "#/$defs/TranscriptFailureCode",
          "description": "The cause."
        },
        "message": {
          "description": "Plain words for the person.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "TranscriptFailureCode": {
      "description": "Why a transcript is `failed` or `partial` ([`TranscriptFailure::code`]). Stored in\n`recordings.transcript_failure`. Later releases add codes: show\n[`TranscriptFailure::message`] for a code this build does not know.",
      "oneOf": [
        {
          "const": "audio_gone",
          "description": "The audio was deleted (expired, purged, or its record message deleted) before it was\ntranscribed.",
          "type": "string"
        },
        {
          "const": "unsupported_language",
          "description": "The transcriber does not support the language spoken, even when asked to detect it.",
          "type": "string"
        },
        {
          "const": "transcriber_error",
          "description": "The transcriber could not transcribe the audio (it timed out, failed or gave an\nanswer Sew could not read) after its retries.",
          "type": "string"
        },
        {
          "const": "audio_not_captured",
          "description": "Part of the call's audio never reached the recording (the recorder restarted or\nreconnected, storage was full, a key was missing, and the like). Only on `partial`.",
          "type": "string"
        }
      ]
    },
    "TranscriptState": {
      "description": "The transcript. Stored in `recordings.transcript_state`.",
      "oneOf": [
        {
          "const": "pending",
          "description": "No segment transcribed yet.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "Turns are being posted.",
          "type": "string"
        },
        {
          "const": "done",
          "description": "Final, complete.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "Final, with gaps or failed segments.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Final, no turn posted and at least one segment failed.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`Message.recording` on the record message.",
  "properties": {
    "audio": {
      "$ref": "#/$defs/SummaryAudio",
      "description": "The audio."
    },
    "auto": {
      "description": "Auto-started.",
      "type": "boolean"
    },
    "duration_ms": {
      "description": "`stopped_at − started_at` once stopped.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "e2ee": {
      "description": "Always `true` in v2: every call is end-to-end encrypted.",
      "type": "boolean"
    },
    "recording_id": {
      "description": "The recording.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "speaker_ids": {
      "description": "Members whose speech was stored, ascending.",
      "items": {
        "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
      },
      "type": "array"
    },
    "started_at": {
      "description": "When.",
      "format": "date-time",
      "type": "string"
    },
    "started_by": {
      "description": "Who started it.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "stop_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/StopReason"
        },
        {
          "type": "null"
        }
      ],
      "description": "Why."
    },
    "stopped_at": {
      "description": "When it stopped.",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "transcript": {
      "$ref": "#/$defs/SummaryTranscript",
      "description": "The transcript."
    }
  },
  "required": [
    "recording_id",
    "started_by",
    "started_at",
    "auto",
    "speaker_ids",
    "audio",
    "transcript",
    "e2ee"
  ],
  "title": "RecordingSummary",
  "type": "object"
}
