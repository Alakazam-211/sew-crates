      "description": "A DM call record.",
      "type": "string"
    },
    {
      "const": "poll",
      "description": "A poll.",
      "type": "string"
    },
    {
      "const": "transcript",
      "description": "A call transcript.",
      "type": "string"
    }
  ],
  "title": "DeliveryKind"
}
