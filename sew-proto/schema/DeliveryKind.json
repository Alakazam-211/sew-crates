{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What kind of message a delivery carries. v1 sends `text` only;\n`Unknown` renders as text.",
  "oneOf": [
    {
      "const": "text",
      "description": "A chat message.",
      "type": "string"
    },
    {
