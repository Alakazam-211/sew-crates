{
  "$defs": {
    "E2eeCaps": {
      "additionalProperties": false,
      "description": "What the joining client can do. The server refuses an\nincapable client with `422 e2ee_unsupported_client`, so the values themselves are\nnot checked here, only their sizes.",
      "properties": {
        "browser": {
          "description": "`chrome`, `firefox`, `safari` or `other` (web only).",
          "type": [
            "string",
            "null"
          ]
        },
        "ciphersuites": {
          "description": "MLS ciphersuites the client supports; must contain 1 when present.",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "kdf": {
          "description": "`\"hkdf\"`.",
          "type": "string"
        },
        "key_ring_size": {
          "description": "64; anything else is refused at join.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "lib": {
          "description": "`sew-e2ee/<version>`.",
          "type": [
            "string",
            "null"
          ]
        },
        "sdk": {
          "description": "The SDK family (`js`, `rust`, …).",
          "type": "string"
        },
        "sdk_version": {
          "description": "The SDK version as its `ClientInfo` reports it.",
          "type": "string"
        },
        "sender_key_index": {
          "description": "The SDK can move its sender to a new key slot.",
          "type": "boolean"
        }
      },
      "required": [
        "sender_key_index",
        "kdf",
        "key_ring_size",
        "sdk",
        "sdk_version"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The `e2ee` object of a voice or call join (`VoiceJoinRequest.e2ee`, and DM call\njoins).",
  "properties": {
    "caps": {
      "$ref": "#/$defs/E2eeCaps",
      "description": "What the client can do."
    },
    "gateway_session": {
      "description": "The caller's gateway session: READY's `session_id`.",
      "type": "string"
    },
    "key_package_ref": {
      "description": "The single-use ref the KeyPackage upload returned (32 bytes).",
      "pattern": "^[A-Za-z0-9_-]*$",
      "type": "string"
    }
  },
  "required": [
    "key_package_ref",
    "gateway_session",
    "caps"
  ],
  "title": "E2eeJoin",
  "type": "object"
}
