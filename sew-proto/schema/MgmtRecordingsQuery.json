{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Query of `GET /mgmt/v1/spaces/{space_id}/recordings`.",
  "properties": {
    "after": {
      "description": "Recordings with ids above this one (the previous page's `next`).",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    },
    "app_id": {
      "description": "The Space's governing App (its view); absent: the compliance view of the install's\nOwner or an Admin named by `Sew-Actor`.",
      "type": [
        "string",
        "null"
      ]
    },
    "limit": {
      "description": "At most this many (1–100, default 50).",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "title": "MgmtRecordingsQuery",
  "type": "object"
}
