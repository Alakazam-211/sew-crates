{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`space_timeout_carry.ndjson` (full exports only): a running timeout of a\nmember who is not in the space, restored if they return before it ends.",
  "properties": {
    "member_id": {
      "description": "The member.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "space_id": {
      "description": "The space.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "timeout_until": {
      "description": "When the timeout ends.",
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "space_id",
    "member_id",
    "timeout_until"
  ],
  "title": "TimeoutCarryRecord",
  "type": "object"
}
