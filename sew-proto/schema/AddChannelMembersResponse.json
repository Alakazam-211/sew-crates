{
  "$defs": {
    "ChannelMember": {
      "description": "A channel membership row.",
      "properties": {
        "channel_id": {
          "description": "The channel.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "joined_at": {
          "description": "When they joined.",
          "format": "date-time",
          "type": "string"
        },
        "member_id": {
          "description": "The member.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        }
      },
      "required": [
        "channel_id",
        "member_id",
        "joined_at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response of `POST /api/v1/channels/{id}/members/add`.",
  "properties": {
    "added": {
      "description": "The memberships created.",
      "items": {
        "$ref": "#/$defs/ChannelMember"
      },
      "type": "array"
    },
    "already": {
      "description": "Ids that already were members.",
      "items": {
        "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
      },
      "type": "array"
    },
    "banned": {
      "description": "The ids of `skipped` that are banned from the space: present only for BAN_MEMBERS\nholders and install owners and admins.",
      "items": {
        "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
      },
      "type": "array"
    },
    "skipped": {
      "description": "Ids that were not added because they cannot join the channel's space (a\nbanned guest never fails the batch); no reason is given here.",
      "items": {
        "description": "A Sew id: a decimal string of a 64-bit time-sortable id (1 to 9223372036854775807).",
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "added",
    "already"
  ],
  "title": "AddChannelMembersResponse",
  "type": "object"
}
