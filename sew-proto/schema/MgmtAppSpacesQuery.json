{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Query of `GET /mgmt/v1/apps/{app_id}/spaces`.",
  "properties": {
    "after": {
      "description": "Links of Spaces with an id above this one (the previous page's `next`).",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    },
    "limit": {
      "description": "Page size, 1–500 (default 100).",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "title": "MgmtAppSpacesQuery",
  "type": "object"
}
