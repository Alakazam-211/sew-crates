{
  "$defs": {
    "MgmtVoiceChangeKind": {
      "description": "What a voice change is.",
      "oneOf": [
        {
          "const": "joined",
          "description": "A member joined a voice channel (or came in by a move; `state` is set).",
          "type": "string"
        },
        {
          "const": "updated",
          "description": "A member's state changed in the same channel (connected, mute, deafen; `state`).",
          "type": "string"
        },
        {
          "const": "left",
          "description": "A member left a voice channel (`reason`: `left`, `moved`, `channel_archived`,\n`media_path_down`, …).",
          "type": "string"
        },
        {
          "const": "channel_closing",
          "description": "The room is closing: no new joins; archived when its last person leaves.",
          "type": "string"
        },
        {
          "const": "channel_archived",
          "description": "The voice channel was archived.",
          "type": "string"
        }
      ]
    },
    "MgmtVoiceState": {
      "description": "One member's voice state in a Space's voice channel.",
      "properties": {
        "channel_id": {
          "description": "The voice channel.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "connection": {
          "$ref": "#/$defs/VoiceConnection",
          "description": "`connecting` or `connected`."
        },
        "external_id": {
          "description": "The member's external id (`k2:owner`, `k2:connect:<uuid>`, …).",
          "maxLength": 128,
          "pattern": "^(k2:(principal|workspace|connect):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|k2:owner|k2:server|local:[a-z0-9_-]{2,64}|link:[1-9][0-9]{0,18}:[A-Z2-7]{16}|app:[a-z0-9][a-z0-9._-]{0,63})$",
          "type": "string"
        },
        "joined_at": {
          "description": "When the join succeeded (a move resets it).",
          "format": "date-time",
          "type": "string"
        },
        "member_id": {
          "description": "The member.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "self_deaf": {
          "description": "Deafened by the member.",
          "type": "boolean"
        },
        "self_mute": {
          "description": "Muted by the member.",
          "type": "boolean"
        },
        "server_deaf": {
          "description": "Deafened by a moderator.",
          "type": "boolean"
        },
        "server_mute": {
          "description": "Muted by a moderator.",
          "type": "boolean"
        }
      },
      "required": [
        "channel_id",
        "member_id",
        "external_id",
        "connection",
        "self_mute",
        "self_deaf",
        "server_mute",
        "server_deaf",
        "joined_at"
      ],
      "type": "object"
    },
    "VoiceConnection": {
      "description": "Whether the engine has confirmed the member's media.",
      "oneOf": [
        {
          "const": "connecting",
          "description": "The admit is registered; media not confirmed yet.",
          "type": "string"
        },
        {
          "const": "connected",
          "description": "The engine confirmed the participant (also during a reconnect window).",
          "type": "string"
        }
      ]
    },
    "VoiceLeaveReason": {
      "description": "Why a member left voice. Sent only to the member themself. Codes are\nstable for metrics and logs.",
      "oneOf": [
        {
          "const": "left",
          "description": "The member left.",
          "type": "string"
        },
        {
          "const": "disconnected",
          "description": "The media connection ended for good.",
          "type": "string"
        },
        {
          "const": "replaced",
          "description": "Another device took over (swap).",
          "type": "string"
        },
        {
          "const": "moved",
          "description": "Moved (or switched) to another channel.",
          "type": "string"
        },
        {
          "const": "removed_by_moderator",
          "description": "A moderator disconnected the member.",
          "type": "string"
        },
        {
          "const": "perms_lost",
          "description": "CONNECT or VIEW was lost.",
          "type": "string"
        },
        {
          "const": "channel_archived",
          "description": "The channel was archived.",
          "type": "string"
        },
        {
          "const": "removed_from_space",
          "description": "The member left or was removed from the space.",
          "type": "string"
        },
        {
          "const": "timed_out",
          "description": "The member was timed out.",
          "type": "string"
        },
        {
          "const": "account_removed",
          "description": "The account was deprovisioned.",
          "type": "string"
        },
        {
          "const": "session_revoked",
          "description": "The login session was revoked.",
          "type": "string"
        },
        {
          "const": "device_revoked",
          "description": "The device was revoked.",
          "type": "string"
        },
        {
          "const": "orphaned",
          "description": "The media outlived every socket.",
          "type": "string"
        },
        {
          "const": "alone_timeout",
          "description": "Alone in the channel too long.",
          "type": "string"
        },
        {
          "const": "connect_timeout",
          "description": "Media never connected.",
          "type": "string"
        },
        {
          "const": "media_restarted",
          "description": "The engine restarted or was down and the media did not come back.",
          "type": "string"
        },
        {
          "const": "voice_disabled",
          "description": "Voice was turned off.",
          "type": "string"
        },
        {
          "const": "e2ee_sender_index_stuck",
          "description": "The sender stayed on a stale key slot.",
          "type": "string"
        },
        {
          "const": "call_ended",
          "description": "The DM call ended.",
          "type": "string"
        },
        {
          "const": "media_unused",
          "description": "Self-only (no leave): a camera or screen lease was released unused.",
          "type": "string"
        },
        {
          "const": "media_revoked",
          "description": "Self-only (no leave): a camera or screen lease was revoked.",
          "type": "string"
        },
        {
          "const": "unresponsive",
          "description": "The device stopped answering key requests (removed as unresponsive).",
          "type": "string"
        },
        {
          "const": "e2ee_unsupported_client",
          "description": "The engine refused the device's client (an SDK that cannot switch the sender key index)\nafter Sew admitted it; the join is dropped at once.",
          "type": "string"
        },
        {
          "const": "recording_declined",
          "description": "Declined the recording notice while declining means not joining.",
          "type": "string"
        },
        {
          "const": "recording_withdrawn",
          "description": "Withdrew recording consent while declining means not joining.",
          "type": "string"
        },
        {
          "const": "recording_consent_timeout",
          "description": "Left the recording notice unanswered too long while declining means not joining.",
          "type": "string"
        },
        {
          "const": "space_orphaned",
          "description": "The voice channel's Space was unbound from its App: a read-only orphan.",
          "type": "string"
        },
        {
          "const": "media_path_down",
          "description": "K2 said the media path (the TURN lane) is down: every live call\nended.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One change of a Space's voice feed.",
  "properties": {
    "channel_id": {
      "description": "The voice channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "external_id": {
      "description": "The member's external id (`joined`, `updated`, `left`).",
      "maxLength": 128,
      "pattern": "^(k2:(principal|workspace|connect):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|k2:owner|k2:server|local:[a-z0-9_-]{2,64}|link:[1-9][0-9]{0,18}:[A-Z2-7]{16}|app:[a-z0-9][a-z0-9._-]{0,63})$",
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "$ref": "#/$defs/MgmtVoiceChangeKind",
      "description": "What it is."
    },
    "member_id": {
      "description": "The member (`joined`, `updated`, `left`).",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/VoiceLeaveReason"
        },
        {
          "type": "null"
        }
      ],
      "description": "Why the member left (`left`)."
    },
    "seq": {
      "description": "The change's place in the Space's feed (increasing; gaps are never skipped changes).",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/MgmtVoiceState"
        },
        {
          "type": "null"
        }
      ],
      "description": "The state now (`joined`, `updated`)."
    }
  },
  "required": [
    "seq",
    "kind",
    "channel_id"
  ],
  "title": "MgmtVoiceChange",
  "type": "object"
}
