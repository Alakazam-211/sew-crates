{
  "$defs": {
    "SpaceBan": {
      "description": "One space ban (`POST /api/v1/spaces/{id}/bans`, `GET …/bans`, `GET …/bans/{member_id}`).\nReadable only by BAN_MEMBERS holders and install owners and admins.",
      "properties": {
        "banned_at": {
          "description": "When.",
          "format": "date-time",
          "type": "string"
        },
        "banned_by": {
          "description": "Who banned them (absent for a ban restored without one).",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": [
            "string",
            "null"
          ]
        },
        "delete_window_s": {
          "description": "The recent-message delete window chosen at ban time, seconds.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "member_id": {
          "description": "The banned member.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "reason": {
          "description": "The reason, when one was given (and its key is not shredded).",
          "type": [
            "string",
            "null"
          ]
        },
        "space_id": {
          "description": "The space.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        }
      },
      "required": [
        "space_id",
        "member_id",
        "banned_at",
        "delete_window_s"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A page of an id-keyed list: `{\"items\": [...], \"has_more\": bool}`.",
  "properties": {
    "has_more": {
      "description": "Whether more items exist past this page.",
      "type": "boolean"
    },
    "items": {
      "description": "The items.",
      "items": {
        "$ref": "#/$defs/SpaceBan"
      },
      "type": "array"
    }
  },
  "required": [
    "items",
    "has_more"
  ],
  "title": "Page",
  "type": "object"
}
