{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`dm_seen.ndjson` (full exports only, since minor 14): the seen positions of DM members\n(read receipts).",
  "properties": {
    "channel_id": {
      "description": "The DM or group DM.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "member_id": {
      "description": "The member.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "seen_at": {
      "description": "Last move.",
      "format": "date-time",
      "type": "string"
    },
    "seen_id": {
      "description": "Seen up to here (a comparator).",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "required": [
    "channel_id",
    "member_id",
    "seen_id",
    "seen_at"
  ],
  "title": "DmSeenRecord",
  "type": "object"
}
