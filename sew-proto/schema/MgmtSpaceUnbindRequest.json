{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /mgmt/v1/spaces/unbind`.",
  "properties": {
    "app_id": {
      "description": "The App it is bound to (on a repeat: the App it was orphaned from).",
      "type": "string"
    },
    "space_id": {
      "description": "The Space.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "required": [
    "space_id",
    "app_id"
  ],
  "title": "MgmtSpaceUnbindRequest",
  "type": "object"
}
