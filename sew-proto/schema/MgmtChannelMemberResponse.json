{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response of `POST /mgmt/v1/channels/{channel_id}/members/add` and `…/members/remove`.",
  "properties": {
    "changed": {
      "description": "Whether this call changed the membership: `false` when the member was already in the\nchannel (add) or not in it (remove).",
      "type": "boolean"
    },
    "channel_id": {
      "description": "The channel.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "external_id": {
      "description": "The member, as named.",
      "maxLength": 128,
      "pattern": "^(k2:(principal|workspace|connect):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|k2:owner|k2:server|local:[a-z0-9_-]{2,64}|link:[1-9][0-9]{0,18}:[A-Z2-7]{16}|app:[a-z0-9][a-z0-9._-]{0,63}|erased:[1-9][0-9]{0,18})$",
      "type": "string"
    },
    "member_id": {
      "description": "The member's id.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    },
    "space_id": {
      "description": "Its Space.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "required": [
    "channel_id",
    "space_id",
    "external_id",
    "member_id",
    "changed"
  ],
  "title": "MgmtChannelMemberResponse",
  "type": "object"
}
