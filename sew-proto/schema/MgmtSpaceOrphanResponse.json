{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Answer of `POST /mgmt/v1/spaces/unbind` and `POST /mgmt/v1/spaces/release`.",
  "properties": {
    "app_id": {
      "description": "The App it is bound to now; absent for an orphaned or unbound Space.",
      "type": [
        "string",
        "null"
      ]
    },
    "changed": {
      "description": "`false` when the call changed nothing (a repeat).",
      "type": "boolean"
    },
    "orphaned_from": {
      "description": "The App it was unbound from while it is a read-only orphan; absent otherwise.",
      "type": [
        "string",
        "null"
      ]
    },
    "space_id": {
      "description": "The Space.",
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
    }
  },
  "required": [
    "space_id",
    "changed"
  ],
  "title": "MgmtSpaceOrphanResponse",
  "type": "object"
}
