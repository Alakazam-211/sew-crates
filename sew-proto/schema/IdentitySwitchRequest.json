{
  "$defs": {
    "ProviderKind": {
      "description": "The install's identity provider.",
      "oneOf": [
        {
          "const": "k2",
          "description": "K2 grants create accounts; K2 signs the pass.",
          "type": "string"
        },
        {
          "const": "standalone",
          "description": "Local users and passwords.",
          "type": "string"
        },
        {
          "const": "link",
          "description": "A meeting-link session (session provider 3, made by redeeming a\nmeeting link). Never an install's provider.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Body of `POST /mgmt/v1/identity/switch`.",
  "properties": {
    "confirm": {
      "description": "Must be `true`: the switch cannot be undone.",
      "type": "boolean"
    },
    "to": {
      "$ref": "#/$defs/ProviderKind",
      "description": "The new mode; only `k2`."
    }
  },
  "required": [
    "to",
    "confirm"
  ],
  "title": "IdentitySwitchRequest",
  "type": "object"
}
