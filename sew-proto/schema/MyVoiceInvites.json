{
  "$defs": {
    "VoiceInvite": {
      "description": "A voice invite: the body of `voice_invite` (to the invitee's and the inviter's sessions,\nnever the rest of the room), the answer of decline and cancel, an item of\n`ReadyChannel.voice_invites` and of [`MyVoiceInvites`].",
      "properties": {
        "channel_id": {
          "description": "The voice channel.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "created_at": {
          "description": "When it was made.",
          "format": "date-time",
          "type": "string"
        },
        "expires_at": {
          "description": "When it expires.",
          "format": "date-time",
          "type": "string"
        },
        "invite_id": {
          "description": "The invite.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "invited_by": {
          "description": "The inviter.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "member_id": {
          "description": "The invitee.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "reason": {
          "description": "On a silent pending invite, why it is silent (`busy`, `muted`, `rate_limited`, `dnd`);\non a stopped one, the stop (the same word as `state`). Absent otherwise.",
          "type": [
            "string",
            "null"
          ]
        },
        "recorded": {
          "description": "The room has a live recording or records every call (the invitee's copy only; absent\nwhen `false`). Joining still meets the recording notice.",
          "type": "boolean"
        },
        "silent": {
          "description": "The invitee is not pushed (the invitee's copy only; absent when `false`): clients stay\nquiet and still show it in the room UI.",
          "type": "boolean"
        },
        "space_id": {
          "description": "Its Space.",
          "pattern": "^[1-9][0-9]{0,18}$",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/VoiceInviteState",
          "description": "Where it stands."
        }
      },
      "required": [
        "invite_id",
        "channel_id",
        "space_id",
        "invited_by",
        "member_id",
        "state",
        "expires_at",
        "created_at"
      ],
      "type": "object"
    },
    "VoiceInviteState": {
      "description": "Where a voice invite stands. `pending` until it stops; every other value is a stop.",
      "oneOf": [
        {
          "const": "pending",
          "description": "Waiting for the invitee.",
          "type": "string"
        },
        {
          "const": "accepted",
          "description": "The invitee joined the room (on any device).",
          "type": "string"
        },
        {
          "const": "declined",
          "description": "The invitee declined.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The inviter cancelled.",
          "type": "string"
        },
        {
          "const": "inviter_left",
          "description": "The inviter left the room (left, was moved out or disconnected).",
          "type": "string"
        },
        {
          "const": "expired",
          "description": "Nobody answered before `expires_at`.",
          "type": "string"
        },
        {
          "const": "room_ended",
          "description": "The room ended: archived, closing, its session ended, voice turned off or the media\npath down.",
          "type": "string"
        },
        {
          "const": "revoked",
          "description": "The invitee can no longer join the room: no longer able to connect, deactivated,\nout of the Space, or erased.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response of `GET /api/v1/me/voice/invites`: the caller's pending invites, oldest first.",
  "properties": {
    "incoming": {
      "description": "Invites to the caller.",
      "items": {
        "$ref": "#/$defs/VoiceInvite"
      },
      "type": "array"
    },
    "outgoing": {
      "description": "Invites the caller sent.",
      "items": {
        "$ref": "#/$defs/VoiceInvite"
      },
      "type": "array"
    }
  },
  "required": [
    "incoming",
    "outgoing"
  ],
  "title": "MyVoiceInvites",
  "type": "object"
}
